# ---------------------------------------------------------------------------
# Copy to .env.development / .env.staging / .env.production
# Only EXPO_PUBLIC_* variables are inlined into the JS bundle.
# NEVER put a real secret here — anything in the bundle is readable.
# ---------------------------------------------------------------------------

# development | staging | production
EXPO_PUBLIC_ENV=development

# Base REST URL of the NestJS backend (must end with the API version segment)
# Android emulator -> http://10.0.2.2:3000/api/v1
# iOS simulator    -> http://localhost:3000/api/v1
# Physical device  -> http://<your-lan-ip>:3000/api/v1
EXPO_PUBLIC_API_URL=https://student-backend-814y.onrender.com/api/v1

# Run against the built-in mock backend (true until the real API exists)
EXPO_PUBLIC_USE_MOCKS=true

# Request timeout in milliseconds
EXPO_PUBLIC_API_TIMEOUT=20000

# Support channel shown on the "Forgot password" / contact-admin screen
EXPO_PUBLIC_SUPPORT_PHONE=+201000000000
EXPO_PUBLIC_SUPPORT_WHATSAPP=+201000000000
EXPO_PUBLIC_SUPPORT_EMAIL=support@example.com

# Feature flags
EXPO_PUBLIC_ENABLE_DRM=false
EXPO_PUBLIC_ENABLE_ROOT_DETECTION=true
EXPO_PUBLIC_ENABLE_QUERY_PERSISTENCE=true

# Seconds before a playback ticket expires client-side (backend is authoritative)
EXPO_PUBLIC_PLAYBACK_TICKET_TTL=300

# Public legal pages (both stores require them to be reachable in the app).
# Optional in development; set them for store builds.
EXPO_PUBLIC_PRIVACY_POLICY_URL=
EXPO_PUBLIC_TERMS_URL=
# Web page where a student can request account deletion (Google Play asks
# for this URL in the Data safety form).
EXPO_PUBLIC_ACCOUNT_DELETION_URL=

# EAS project id printed by `eas init` (public, not a secret). The OTA
# updates URL is derived from it (https://u.expo.dev/<id>); set
# EXPO_UPDATES_URL only to override that.
EAS_PROJECT_ID=
EXPO_UPDATES_URL=

# ---------------------------------------------------------------------------
# Store builds (eas build --profile production) do NOT read this file.
# Set the production values as EAS environment variables in the
# "production" environment, e.g.:
#   eas env:create --environment production --name EXPO_PUBLIC_API_URL \
#     --value https://<your-api-host>/api/v1 --visibility plaintext
# A production build refuses to start if the API URL is missing, not https,
# local, or a placeholder, or if the support contacts are placeholders.
# ---------------------------------------------------------------------------
