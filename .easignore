# EAS build upload context.
# When this file exists EAS CLI uses it INSTEAD of .gitignore
# (https://docs.expo.dev/build-reference/easignore/), so every .gitignore rule
# is repeated here, followed by files the build worker never needs.

# --- copied from .gitignore ---------------------------------------------
node_modules/
.expo/
dist/
web-build/
*.log
npm-debug.*
yarn-error.*

# Native projects are generated by `expo prebuild` on the EAS worker. The local
# android/ folder is a stale development-variant prebuild and must never be
# uploaded, or EAS would treat the project as bare and build that instead.
/ios
/android
**/build/
**/.gradle/

# Secrets & credentials — never uploaded. google-services.json reaches the
# worker through the GOOGLE_SERVICES_JSON *file* environment variable.
.env
.env.local
.env.development
.env.staging
.env.production
credentials/
*.p8
*.p12
*.mobileprovision
*.keystore
*.jks
google-services.json
GoogleService-Info.plist

.DS_Store
*.tsbuildinfo
coverage/
expo-env.d.ts

# --- not needed to build the app -----------------------------------------
release/
docs/
*.aab
*.apk
.vscode/
__tests__/
.idea/
