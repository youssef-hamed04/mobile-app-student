{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "env": {}
    },
    "development": {
      "extends": "base",
      "environment": "development",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "APP_VARIANT": "development",
        "EXPO_PUBLIC_ENV": "development",
        "EXPO_PUBLIC_API_URL": "http://10.0.2.2:3000/api/v1",
        "EXPO_PUBLIC_USE_MOCKS": "false"
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      },
      "ios": {
        "simulator": true
      }
    },
    "development:device": {
      "extends": "development",
      "ios": {
        "simulator": false
      }
    },
    "staging": {
      "extends": "base",
      "environment": "preview",
      "distribution": "internal",
      "channel": "staging",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "staging",
        "EXPO_PUBLIC_ENV": "staging",
        "EXPO_PUBLIC_USE_MOCKS": "false",
        "EXPO_PUBLIC_API_URL": "https://student-backend-814y.onrender.com/api/v1",
        "STAGING_USES_PRODUCTION_API": "acknowledged"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "extends": "base",
      "environment": "production",
      "distribution": "store",
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "production",
        "EXPO_PUBLIC_ENV": "production",
        "EXPO_PUBLIC_USE_MOCKS": "false",
        "EXPO_PUBLIC_API_URL": "https://student-backend-814y.onrender.com/api/v1",
        "EXPO_PUBLIC_ENABLE_LIBRARY": "true",
        "EXPO_PUBLIC_ENABLE_WALLET": "false",
        "EXPO_PUBLIC_ENABLE_COURSE_ACTIVATION": "false",
        "EXPO_PUBLIC_SHOW_COURSE_PRICES": "false",
        "EXPO_PUBLIC_ENABLE_DIGITAL_PURCHASES": "false"
      },
      "android": {
        "channel": "google-play-production",
        "buildType": "app-bundle"
      }
    },
    "production:apk": {
      "extends": "production",
      "autoIncrement": false,
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./credentials/play-service-account.json",
        "track": "internal",
        "releaseStatus": "draft"
      },
      "ios": {}
    }
  }
}