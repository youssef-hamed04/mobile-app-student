{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "env": {}
    },
    "development": {
      "extends": "base",
      "environment": "development",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "APP_VARIANT": "development",
        "EXPO_PUBLIC_ENV": "development",
        "EXPO_PUBLIC_API_URL": "http://10.0.2.2:3000/api/v1",
        "EXPO_PUBLIC_USE_MOCKS": "false"
      },
      "android": { "buildType": "apk", "gradleCommand": ":app:assembleDebug" },
      "ios": { "simulator": true }
    },
    "development:device": {
      "extends": "development",
      "ios": { "simulator": false }
    },
    "staging": {
      "extends": "base",
      "environment": "preview",
      "distribution": "internal",
      "channel": "staging",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "staging",
        "EXPO_PUBLIC_ENV": "staging",
        "EXPO_PUBLIC_USE_MOCKS": "false"
      },
      "android": { "buildType": "apk" }
    },
    "production": {
      "extends": "base",
      "environment": "production",
      "distribution": "store",
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "production",
        "EXPO_PUBLIC_ENV": "production",
        "EXPO_PUBLIC_USE_MOCKS": "false"
      },
      "android": { "buildType": "app-bundle" }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./credentials/play-service-account.json",
        "track": "internal",
        "releaseStatus": "draft"
      },
      "ios": {}
    }
  }
}
